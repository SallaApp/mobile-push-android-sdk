<?xml version="1.0" encoding="utf-8"?>
<!--
    The sample's session (its customer token) never leaves the device: no cloud backup, no device transfer. SallaPush
    itself needs no rule: it keeps its files in noBackupFilesDir, which Android never backs up or transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
